<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>5</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TouchTyping</AssemblyName>
    <RootNamespace>TouchTypingStudio</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>../assets/brand/touch-typing.ico</ApplicationIcon>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <AppConfig>../TouchTyping.exe.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../linux/hands.png" LogicalName="TouchTyping.Hands.png" />
    <EmbeddedResource Include="../linux/result-time.png" LogicalName="TouchTyping.Result.time.png" />
    <EmbeddedResource Include="../linux/result-count.png" LogicalName="TouchTyping.Result.count.png" />
    <EmbeddedResource Include="../linux/result-speed.png" LogicalName="TouchTyping.Result.speed.png" />
    <EmbeddedResource Include="../linux/result-accuracy.png" LogicalName="TouchTyping.Result.accuracy.png" />
    <Content Include="../assets/fonts/Roboto-Regular.ttf;../assets/fonts/Roboto-Medium.ttf;../assets/fonts/Roboto-Bold.ttf;../assets/fonts/OFL.txt;../assets/fonts/ROBOTO-SOURCE.txt">
      <Link>fonts/%(Filename)%(Extension)</Link>
      <TargetPath>fonts/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Include="../*.cs" Link="%(Filename)%(Extension)" />
    <Reference Include="PresentationCore;PresentationFramework;WindowsBase;UIAutomationClient;UIAutomationTypes;System.Xaml;System.IO.Compression;System.Web.Extensions;Microsoft.CSharp" />
  </ItemGroup>
</Project>
