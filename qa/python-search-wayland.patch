@@ -0,0 +1,87 @@
+"""Regression exercised by isolated GNOME Wayland, not standalone product logic."""
+import hashlib, json, os, re
+from pathlib import Path
+
+def exercise(self, chord, capture, output):
+    import touch_typing
+    expected_pkg = Path(__file__).resolve().parent.parent
+    assert Path(touch_typing.__file__).resolve().parent == expected_pkg
+    assert os.environ.get('WAYLAND_DISPLAY') == 'training-qa'
+    assert self.window.get_display().__gtype__.name == 'GdkWaylandDisplay'
+    lab = self.lab
+    lab.picker.set_selected(next(i for i, c in enumerate(lab.classes) if c['id'] == 'code'))
+    lab.level.set_selected(0)
+    lab.limit.set_selected(0)
+    lab.time_limit.set_selected(0)
+    lab.mission_picker.set_selected(next(i for i, (key, _) in enumerate(lab.choices) if key == 'code-find-exact-edit'))
+    yield
+    lab.start()
+    yield from self.await_lesson_capture(chord)
+    assert self.layout == 'EN', self.layout
+
+    root = '/home/student/project/task-list/'
+    def active():
+        return next(w for w in lab.state['scene']['windows'] if w['active'] and w['app'] == 'code')
+    def disk():
+        return {f['path'][len(root):]: f['content'] for f in lab.state['scene']['terminal']['files'] if f['path'].startswith(root)}
+    def read(step, phase, file, anchor, caret):
+        w = active()
+        seen = lab.state['solved'], w['focus'], w['projectRelative'], w['bodyAnchor'], w['bodyCursor']
+        assert seen == (step, phase, file, anchor, caret), (seen, lab.state['status'])
+        print('PASS', seen, w['status'], flush=True)
+    def typed(s):
+        for ch in s: yield from chord(ch.upper())
+
+    baseline = disk()
+    assert set(baseline) == {'app.py','tasks.py','storage.py','test_tasks.py'}
+    original = baseline['app.py']
+    hits = [m.start() for m in re.finditer('draft', original)]
+    assert len(hits) == 3
+    read(0, 'body', 'tasks.py', 0, 0)
+    yield from chord('Ctrl+P')
+    read(1, 'quick-open', 'tasks.py', 0, 0)
+    yield from typed('ap')
+    yield from chord('Enter')
+    read(2, 'body', 'app.py', 0, 0)
+    capture(output/'01-file-open.png'); yield
+    yield from chord('Ctrl+F')
+    read(3, 'find', 'app.py', 0, 0)
+    yield from typed('absent')
+    yield from chord('Enter')
+    read(3, 'find', 'app.py', 0, 0)
+    assert active()['status'] == 'Совпадений нет' and disk() == baseline
+    for _ in 'absent': yield from chord('Backspace')
+    yield from typed('draft')
+    yield from chord('Enter')
+    read(4, 'find', 'app.py', hits[0], hits[0]+5)
+    for j, selected in enumerate([1, 2, 0, 2, 1]):
+        yield from chord('F3' if j < 3 else 'Shift+F3')
+        read(5+j, 'find', 'app.py', hits[selected], hits[selected]+5)
+    capture(output/'02-second-match.png'); yield
+    yield from chord('Esc')
+    read(10,'body','app.py',hits[1],hits[1]+5)
+    yield from typed('ready')
+    fixed = {**baseline, 'app.py': original[:hits[1]] + 'ready' + original[hits[1]+5:]}
+    assert active()['body'] == fixed['app.py'] and disk() == baseline
+    yield from chord('Ctrl+S')
+    read(11,'body','app.py',hits[1]+5,hits[1]+5)
+    assert disk() == fixed
+    assert fixed['app.py'].count('draft') == 2 and fixed['app.py'].count('ready') == 1
+    capture(output/'03-saved-only-report.png'); yield
+    yield from chord('Home')
+    call = fixed['app.py'].rfind('\n', 0, hits[1])+1
+    read(12,'body','app.py',call,call)
+    yield from chord('F12')
+    definition = baseline['tasks.py'].index('add_task(')
+    read(13,'body','tasks.py',definition,definition)
+    capture(output/'04-definition.png'); yield
+    yield from chord('Ctrl+Alt+-')
+    read(14,'body','app.py',call,call)
+    assert disk() == fixed and lab.state['finished'] and lab.state['saved'] and lab.result
+    capture(output/'05-result.png'); yield
+    digest = lambda s: hashlib.sha256(s.encode()).hexdigest()
+    evidence = {name: {'before': digest(content), 'after': digest(fixed[name])} for name, content in baseline.items()}
+    (output/'proof.json').write_text(json.dumps({'sha':'444892cf','surface':'exact unmodified package GTK4/GNOME Wayland; Mutter RemoteDesktop virtual keyboard; actual GDK inhibition',
+        'credit': lab.state['solved'],'restored_file':'app.py','restored_anchor':call,'restored_caret':call,
+        'definition_file':'tasks.py','definition_offset':definition,'files':evidence},indent=2))
+    print('PASS exact 14/14, all four backing files and restored caret', evidence, flush=True)
