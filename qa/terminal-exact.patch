+    private static void CheckExactTerminalEditSequences()
+    {
+        Check(Visible("LabDesktop") && Find("LabDesktop").Current.ItemStatus.StartsWith("cursor:", StringComparison.Ordinal),
+            "The visible scene exposes the active terminal caret");
+        CheckExactTerminalEdit(false, false);
+        CheckExactTerminalEdit(false, true);
+        CheckExactTerminalEdit(true, false);
+        CheckExactTerminalEdit(true, true);
+        Chord("LCtrl+U");
+        CheckTerminalState("", 0);
+    }
+
+    private static void CheckExactTerminalEdit(bool recalled, bool backspace)
+    {
+        string op = backspace ? "Backspace" : "Delete";
+        string origin = recalled ? "history" : "fresh";
+        string label = "terminal-" + origin + "-" + op.ToLowerInvariant();
+        Chord("LCtrl+U");
+        CheckTerminalState("", 0);
+        TypeStockText("abcd");
+        CheckTerminalState("abcd", 4);
+        if (recalled)
+        {
+            Key("Enter"); // Only the trainer's virtual shell; no host command executes.
+            CheckTerminalState("", 0);
+            Key("Up");
+            CheckTerminalState("abcd", 4);
+        }
+        Key("Left");
+        CheckTerminalState("abcd", 3);
+        Key("Left");
+        CheckTerminalState("abcd", 2);
+        CaptureExactTerminalFrame(label + "-caret-between-b-c", "abcd", 2);
+        Key(op);
+        CheckTerminalState(backspace ? "acd" : "abd", backspace ? 1 : 2);
+        Send(Character('X'));
+        CheckTerminalState(backspace ? "aXcd" : "abXd", backspace ? 2 : 3);
+        CaptureExactTerminalFrame(label + "-after-insert", backspace ? "aXcd" : "abXd", backspace ? 2 : 3);
+        Check(true, "Exact " + origin + " " + op + " gives " + (backspace ? "aXcd at caret 2" : "abXd at caret 3"));
+    }
+
+    private static void CaptureExactTerminalFrame(string label, string text, int caret)
+    {
+        if (evidenceDirectory == null || app.HasExited || GetForegroundWindow() != trainer)
+            throw new InvalidOperationException("Exact terminal screenshot requires the owned foreground trainer.");
+        CaptureRect client;
+        var origin = new CapturePoint();
+        if (!GetClientRect(trainer, out client) || !ClientToScreen(trainer, ref origin))
+            throw new InvalidOperationException("Unable to read actual foreground client geometry.");
+        var actual = new Rectangle(origin.X + client.Left, origin.Y + client.Top,
+            client.Right - client.Left, client.Bottom - client.Top);
+        var monitor = System.Windows.Forms.Screen.FromHandle(trainer).Bounds;
+        var visible = Rectangle.Intersect(actual, monitor);
+        var scene = Find("LabDesktop").Current;
+        var sceneBounds = scene.BoundingRectangle;
+        Console.WriteLine("TERMINAL CAMERA " + label + " client=" + actual + " monitor=" + monitor +
+            " visible=" + visible + " scene=" + sceneBounds + " dpi=" + GetDpiForWindow(trainer));
+        if (visible.Width <= 0 || visible.Height <= 0 || scene.IsOffscreen || sceneBounds.IsEmpty ||
+            sceneBounds.Width <= 0 || sceneBounds.Height <= 0 ||
+            !new System.Windows.Rect(visible.X, visible.Y, visible.Width, visible.Height).Contains(sceneBounds))
+            throw new InvalidOperationException("The complete visible terminal scene must fit inside the capture, including its custom-drawn caret.");
+        CheckTerminalState(text, caret);
+        using (var bitmap = new Bitmap(visible.Width, visible.Height))
+        using (var graphics = Graphics.FromImage(bitmap))
+        {
+            graphics.CopyFromScreen(visible.X, visible.Y, 0, 0, visible.Size);
+            if (GetForegroundWindow() != trainer)
+                throw new InvalidOperationException("Trainer lost foreground during terminal screenshot.");
+            CheckTerminalState(text, caret);
+            bitmap.Save(Path.Combine(evidenceDirectory, label + ".png"), ImageFormat.Png);
+        }
+        Console.WriteLine("CAPTURE " + label + " " + visible.Width + "x" + visible.Height +
+            " physical px 1:1; entire terminal scene verified, caret=" + caret);
+    }
