+    private static void CheckHostedNormalEditor(string executable)
+    {
+        Check(Environment.GetEnvironmentVariable("RUNNER_ENVIRONMENT") == "github-hosted" &&
+            Environment.GetEnvironmentVariable("GITHUB_ACTIONS") == "true" &&
+            Environment.GetEnvironmentVariable("TOUCH_TYPING_NORMAL_LAUNCH_ISOLATED_JOB") == "1",
+            "Stock editor check requires the dedicated fresh hosted job");
+        foreach (var name in new[] { "TOUCH_TYPING_QA_DATA_ROOT", "TOUCH_TYPING_QA_SEED",
+            "TOUCH_TYPING_QA_LESSON_CHROME", "TOUCH_TYPING_QA_PYTHON_EDITOR" })
+            Check(string.IsNullOrEmpty(Environment.GetEnvironmentVariable(name)), "No QA override: " + name);
+        var local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+        var normal = Path.Combine(local, "TouchTypingStudio");
+        var qa = Path.Combine(local, "TouchTypingStudio-QA");
+        Check(Path.IsPathRooted(local) && Directory.Exists(local) && !Directory.Exists(normal) &&
+            !File.Exists(normal) && !Directory.Exists(qa) && !File.Exists(qa), "Fresh normal LocalApplicationData");
+        const string mission = "Найти и исправить нужное место";
+        OpenNormalStarter(executable, "code", "VS Code");
+        Invoke("LabClass-code");
+        Select("LabMode", 0); Select("LabLevel", 0); Select("LabDuration", 0); Select("LabTimer", 0);
+        SelectMissionByName(mission);
+        Key("F5");
+        Until(delegate { return EditorAt("tasks.py", "body", 0); }, "normal VS Code starts with the neutral tasks.py");
+        Check(Name("LabCounter").Contains(mission) && ReadSolved() == 0, "The chosen visible mission starts without credit");
+        VirtualEnglish();
+        Chord("Ctrl+P"); TypeStockText("ap"); Key("Enter");
+        Until(delegate { return ReadSolved() == 2 && EditorAt("app.py", "body", 0); }, "quick-open navigates to neutral app.py");
+        Chord("Ctrl+F"); TypeStockText("draft"); Key("Enter");
+        Until(delegate { return ReadSolved() == 4; }, "search finds the real matching text");
+        for (int i = 0; i < 3; i++) Key("F3");
+        for (int i = 0; i < 2; i++) Chord("Shift+F3");
+        Key("Esc");
+        Until(delegate { return ReadSolved() == 10 && EditorAt("app.py", "body", 70); },
+            "return from Find with the report match selected");
+        TypeStockText("ready");
+        Check(ReadSolved() == 10, "Typing alone cannot earn saved-edit credit");
+        Chord("Ctrl+S");
+        Until(delegate { return ReadSolved() == 11 && EditorAt("app.py", "body", 70); }, "Ctrl+S accepts the precise report edit");
+        SaveNormalEditorAndExit();
+
+        var profile = Path.Combine(normal, "progress.xml");
+        Check(File.Exists(profile) && !File.Exists(profile + ".writing") && !Directory.Exists(profile + ".writing") &&
+            !Directory.Exists(qa) && !File.Exists(qa), "Only the normal profile contains the persisted checkpoint");
+        var saved = ReadSingleEditorDraft(profile);
+        var session = saved.SelectSingleNode("Progress/Session").InnerText;
+        Check(!string.IsNullOrEmpty(session) && saved.SelectSingleNode("Progress/Solved").InnerText == "11",
+            "Normal profile stores the exact saved stage and session");
+
+        OpenNormalStarter(executable, "code", "VS Code");
+        Invoke("LabClass-code");
+        Select("LabMode", 0); Select("LabLevel", 0);
+        SelectMissionByName("Продолжить с сохранённого места");
+        Key("F5");
+        Until(delegate { return ReadSolved() == 11 && EditorAt("app.py", "body", 70); },
+            "stock restart restores the exact edited-file stage and caret");
+        Key("Home");
+        Until(delegate { return ReadSolved() == 12 && EditorAt("app.py", "body", 55); },
+            "a new native action advances the restored mission without replay credit");
+        SaveNormalEditorAndExit();
+        saved = ReadSingleEditorDraft(profile);
+        Check(saved.SelectSingleNode("Progress/Session").InnerText == session &&
+            saved.SelectSingleNode("Progress/Solved").InnerText == "12",
+            "Reopen and resave keep one session and advance exactly one stage");
+    }
+
+    private static void TypeStockText(string text)
+    { foreach (char c in text) Send(Character(c)); }
+
+    private static bool EditorAt(string file, string focus, int cursor)
+    {
+        if (!Visible("LabDesktop") || !Visible("LabPause") || !Name("LabPause").StartsWith("Пауза")) return false;
+        var scene = Find("LabDesktop").Current;
+        return scene.Name.StartsWith("Учебный VS Code", StringComparison.Ordinal) && scene.HelpText == file &&
+            scene.ItemStatus == "editor:" + focus + ":" + cursor.ToString(CultureInfo.InvariantCulture);
+    }
+
+    private static void SaveNormalEditorAndExit()
+    {
+        RequestClose();
+        Until(delegate { return ExitDialog() != null; }, "normal editor save and close");
+        InvokeDialog("LabExitSave");
+        CheckNormalTrainerCleanExit("Normal editor saved and exited");
+        app.Dispose();
+        app = null;
+    }
+
+    private static XmlNode ReadSingleEditorDraft(string profile)
+    {
+        var xml = new XmlDocument { XmlResolver = null };
+        xml.Load(profile);
+        var drafts = xml.SelectNodes("/StudioProfile/LiveDrafts/LiveDraft[App='code']");
+        Check(drafts.Count == 1 && !string.IsNullOrEmpty(drafts[0].SelectSingleNode("ProjectFixture").InnerText),
+            "Exactly one neutral VS Code draft exists in normal progress.xml");
+        return drafts[0];
+    }
