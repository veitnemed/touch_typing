+    private static void CheckExactTerminalEditSequences()
+    {
+        Check(Visible("LabDesktop") && Find("LabDesktop").Current.ItemStatus.StartsWith("cursor:", StringComparison.Ordinal),
+            "The visible scene exposes the active terminal caret");
+        CheckExactTerminalEdit(false, false);
+        CheckExactTerminalEdit(false, true);
+        CheckExactTerminalEdit(true, false);
+        CheckExactTerminalEdit(true, true);
+        Chord("LCtrl+U");
+        CheckTerminalState("", 0);
+    }
+
+    private static void CheckExactTerminalEdit(bool recalled, bool backspace)
+    {
+        string op = backspace ? "Backspace" : "Delete";
+        string origin = recalled ? "history" : "fresh";
+        string label = "terminal-" + origin + "-" + op.ToLowerInvariant();
+        Chord("LCtrl+U");
+        CheckTerminalState("", 0);
+        TypeStockText("abcd");
+        CheckTerminalState("abcd", 4);
+        if (recalled)
+        {
+            Key("Enter"); // Only the trainer's virtual shell; no host command executes.
+            CheckTerminalState("", 0);
+            Key("Up");
+            CheckTerminalState("abcd", 4);
+        }
+        Key("Left");
+        CheckTerminalState("abcd", 3);
+        Key("Left");
+        CheckTerminalState("abcd", 2);
+        CaptureReferenceFrame(label + "-caret-between-b-c");
+        Key(op);
+        CheckTerminalState(backspace ? "acd" : "abd", backspace ? 1 : 2);
+        Send(Character('X'));
+        CheckTerminalState(backspace ? "aXcd" : "abXd", backspace ? 2 : 3);
+        CaptureReferenceFrame(label + "-after-insert");
+        Check(true, "Exact " + origin + " " + op + " gives " + (backspace ? "aXcd at caret 2" : "abXd at caret 3"));
+    }
