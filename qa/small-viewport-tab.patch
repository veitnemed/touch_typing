+    private static void CheckHostedSmallViewport(string executable)
+    {
+        OpenNormalStarter(executable, "code", "VS Code");
+        ResizeStockClient(1024, 600);
+        CaptureReferenceFrame("small-01-chooser-first-paint");
+        Invoke("LabClass-code");
+        Select("LabMode", 1); Select("LabLevel", 0); Select("LabDuration", 0); Select("LabTimer", 0);
+        const string mission = "Найти и исправить нужное место";
+        // Seed focus on an existing class once; all scrolling from here to Start is
+        // caused by keyboard focus traversal, never ScrollIntoView or a scrollbar.
+        Find("LabClass-code").SetFocus();
+        ReachViewportControlByTab("LabMission");
+        SelectMissionByName(mission);
+        Find("LabMission").SetFocus(); // restore focus to the combobox after its UIA popup closes
+        ReachViewportControlByTab("LabStart", true);
+        CaptureReferenceFrame("small-01b-start-focused-in-view");
+        Key("Space");
+        Until(delegate { return EditorAt("tasks.py", "body", 0); }, "keyboard-activated Start displays editor caret at zero");
+        CaptureReferenceFrame("small-02-editor-initial");
+        CheckViewportElement("LabTask");
+        Check(Name("LabTask").Length > 0 && Name("LabCounter").Contains(mission), "Small editor displays the actual mission and initial goal");
+        CheckViewportElement("LabDesktop"); CheckViewportElement("LabPause"); CheckViewportElement("LabFinish");
+        VirtualEnglish();
+        Chord("Ctrl+P"); TypeStockText("ap"); Key("Enter");
+        Until(delegate { return ReadSolved() == 2 && EditorAt("app.py", "body", 0); }, "keyboard opens app.py and locates caret within small viewport");
+        CaptureReferenceFrame("small-03-editor-caret");
+        Key("F8");
+        Until(delegate { return Visible("LabPauseResult"); }, "small viewport pause shows result card");
+        CaptureReferenceFrame("small-04-pause-first-paint");
+        Until(delegate { return OwnedFocus("LabPauseContinue"); }, "Continue gets keyboard focus on pause");
+        CheckViewportElement("LabPauseContinue");
+        Chord("Shift+Tab");
+        Check(OwnedFocus("LabPauseRestart"), "Keyboard can move backward from Continue");
+        ReachViewportControlByTab("LabPauseFinish", true);
+        ReachViewportControlByTab("LabPauseContinue");
+        Check(OwnedFocus("LabPauseContinue"), "Keyboard can reach Continue again");
+        Key("Space");
+        Until(delegate { return !Visible("LabPauseResult") && EditorAt("app.py", "body", 0); },
+            "Space resumes with the same editor and caret");
+        Key("F10");
+        Until(delegate { return Visible("LabResult"); }, "F10 opens stored result");
+        CaptureReferenceFrame("small-05-end-result-first-paint");
+        CheckViewportElement("LabResult"); CheckViewportElement("ResultMetric-count");
+        Check(Find("LabResult").Current.HelpText.Contains("Выполнено 2."), "Visible result reports the two real keyboard actions");
+        ReachViewportControlByTab("LabChooseClass", true);
+        CaptureReferenceFrame("small-05b-end-result-action-focused");
+    }
