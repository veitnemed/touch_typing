+    private static void ReachViewportControlByTab(string id, bool reverse = false)
+    {
+        for (int i = 0; i < 30 && !OwnedFocus(id); i++)
+        {
+            var before = AutomationElement.FocusedElement;
+            Console.WriteLine("KEYBOARD " + (reverse ? "Shift+Tab" : "Tab") + " toward " + id +
+                "; prior=" + (before == null ? "<none>" : before.Current.AutomationId));
+            Chord(reverse ? "Shift+Tab" : "Tab");
+        }
+        Check(OwnedFocus(id), id + " reached by keyboard Tab traversal");
+        Until(delegate { return ViewportContains(id); }, id + " scrolls fully into the visible client by keyboard focus");
+        CheckViewportElement(id);
+    }
+
+    private static bool OwnedFocus(string id)
+    {
+        var focus = AutomationElement.FocusedElement;
+        return focus != null && focus.Current.ProcessId == app.Id && focus.Current.AutomationId == id;
+    }
+
+    private static bool ViewportContains(string id)
+    {
+        CaptureRect rect;
+        var origin = new CapturePoint();
+        if (!Visible(id) || !GetClientRect(trainer, out rect) || !ClientToScreen(trainer, ref origin)) return false;
+        var area = new System.Windows.Rect(origin.X, origin.Y, rect.Right - rect.Left, rect.Bottom - rect.Top);
+        var bounds = Find(id).Current.BoundingRectangle;
+        return !bounds.IsEmpty && bounds.Width > 1 && bounds.Height > 1 && area.Contains(bounds);
+    }
+
+    private static void CheckViewportElement(string id)
+    {
+        Check(ViewportContains(id), id + " is visible and entirely inside the real client bounds: " +
+            Find(id).Current.BoundingRectangle);
+    }
+
+    private static void ResizeStockClient(int dipWidth, int dipHeight)
+    {
+        Check(!app.HasExited && window.Current.ProcessId == app.Id && GetForegroundWindow() == trainer,
+            "Only resize the owned foreground stock window");
+        ShowWindow(trainer, 9);
+        Wait(180);
+        var screen = System.Windows.Forms.Screen.FromHandle(trainer);
+        var area = screen.WorkingArea;
+        uint dpi = GetDpiForWindow(trainer);
+        Check(dpi >= 96, "Windows supplied a real window DPI");
+        int width = (int)Math.Round(dipWidth * dpi / 96.0);
+        int height = (int)Math.Round(dipHeight * dpi / 96.0);
+        for (int pass = 0; pass < 4; pass++)
+        {
+            CaptureRect client, outer;
+            if (!GetClientRect(trainer, out client) || !GetWindowRect(trainer, out outer))
+                throw new InvalidOperationException("Cannot read the physical client and outer frame.");
+            int fullWidth = outer.Right - outer.Left + width - (client.Right - client.Left);
+            int fullHeight = outer.Bottom - outer.Top + height - (client.Bottom - client.Top);
+            if (!area.Contains(new Rectangle(area.X, area.Y, fullWidth, fullHeight)))
+                throw new InvalidOperationException("The actual physical desktop cannot fit the requested client at its real DPI.");
+            if (!SetWindowPos(trainer, IntPtr.Zero, area.X, area.Y, fullWidth, fullHeight, 0x0014))
+                throw new InvalidOperationException("Could not size the owned stock window.");
+            Wait(180);
+        }
+        Focus();
+        CaptureRect final;
+        Check(GetClientRect(trainer, out final) && final.Right - final.Left == width &&
+            final.Bottom - final.Top == height && GetDpiForWindow(trainer) == dpi, "Exact native application viewport obtained");
+        Console.WriteLine("MEASURED monitor=" + screen.Bounds.Width + "x" + screen.Bounds.Height +
+            " px; work area=" + area.Width + "x" + area.Height + " px; dpi=" + dpi +
+            "; scale=" + (100.0 * dpi / 96).ToString("0.##", CultureInfo.InvariantCulture) +
+            "%; client=" + width + "x" + height + " px / " + dipWidth + "x" + dipHeight + " DIP");
+    }
