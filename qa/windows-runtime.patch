+    private static void CheckHostedWin10(string executable)
+    {
+        Check(Environment.GetEnvironmentVariable("RUNNER_ENVIRONMENT") == "github-hosted" &&
+            Environment.GetEnvironmentVariable("GITHUB_ACTIONS") == "true" &&
+            Environment.GetEnvironmentVariable("TOUCH_TYPING_NORMAL_LAUNCH_ISOLATED_JOB") == "1" &&
+            string.IsNullOrEmpty(Environment.GetEnvironmentVariable("TOUCH_TYPING_QA_DATA_ROOT")),
+            "Exact stock runtime uses the isolated fresh hosted normal profile");
+        var local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+        var data = Path.Combine(local, "TouchTypingStudio");
+        var qa = Path.Combine(local, "TouchTypingStudio-QA");
+        Check(Directory.Exists(local) && !Directory.Exists(data) && !File.Exists(data) &&
+            !Directory.Exists(qa) && !File.Exists(qa), "Fresh normal profile before the stock launch");
+        OpenNormalStarter(executable, "windows", delegate
+        {
+            Check(Visible("HomeClass-ubuntu") && Name("LabDesktopProfile-ubuntu").Contains("выбрано"),
+                "Fresh Home starts on the Ubuntu curriculum");
+            Invoke("LabDesktopProfile-windows");
+            Until(delegate { return Visible("HomeClass-windows") && !Exists("HomeClass-ubuntu") &&
+                Name("LabDesktopProfile-windows").Contains("выбрано"); }, "Windows 10 choice switches the actual Home catalog");
+            Check(Name("HomeClass-windows").Contains("Windows 10"), "Visible Windows 10 course is selected");
+        });
+        Invoke("LabClass-windows");
+        Select("LabMode", 1);        // Guided.
+        Select("LabLevel", 0);
+        Select("LabDuration", 0);
+        Select("LabTimer", 0);
+        SelectMissionByName("Windows 10: Пуск и окна");
+        Key("F5");
+        Until(delegate { return Win10Scene("Учебный рабочий стол Windows 10") && ReadSolved() == 0; },
+            "visible simulated Windows workspace actually starts");
+        Key("LSuper");
+        Until(delegate { return Win10Scene("Меню Пуск") && ReadSolved() == 1; },
+            "physical Win opens the simulated Start menu and earns one credit");
+        Key("Enter");
+        Until(delegate { return !Win10Scene("Меню Пуск") && ReadSolved() == 2; }, "physical Enter launches the selected simulated app");
+        Chord("LSuper+E");
+        Until(delegate { return Win10Scene("Проводник") && ReadSolved() == 3; }, "physical Win+E opens the simulated Explorer");
+        Chord("LSuper+Left");
+        Until(delegate { return Win10Scene("Подбор второго окна") && Win10Scene("слева") && ReadSolved() == 4; },
+            "physical Win+Left opens Snap Assist and places a real simulated window on the left");
+        Key("Enter");
+        Until(delegate { return !Win10Scene("Подбор второго окна") && Win10Scene("слева") && Win10Scene("справа") &&
+            ReadSolved() == 5; }, "physical Enter chooses a second window, displays both halves and advances the mission");
+        Console.WriteLine("WIN10 SNAP " + Name("LabDesktop"));
+        CloseWin10StockLesson();
+        var profile = Path.Combine(data, "progress.xml");
+        Check(File.Exists(profile) && !Directory.Exists(qa), "Normal Windows profile persisted, without using a QA profile");
+        var xml = new XmlDocument { XmlResolver = null };
+        xml.Load(profile);
+        var choice = xml.SelectSingleNode("/StudioProfile/LabDesktopEnvironment");
+        Check(choice != null && choice.InnerText == "windows", "Persisted preference actually contains Windows");
+        OpenNormalStarter(executable, "terminal", delegate
+        {
+            Check(Visible("HomeClass-windows") && !Exists("HomeClass-ubuntu") &&
+                Name("LabDesktopProfile-windows").Contains("выбрано"), "Normal restart rehydrates the Windows choice");
+        });
+        Invoke("LabClass-terminal");
+        Select("LabMode", 1); Select("LabLevel", 0); Select("LabDuration", 0); Select("LabTimer", 0);
+        Key("F5");
+        Until(delegate { return Exists("LabDesktop") && Name("LabPause").StartsWith("Пауза"); }, "packaged terminal training starts after restart");
+        VirtualEnglish();
+        Chord("LCtrl+U");
+        CheckTerminalState("", 0);
+        foreach (char character in "abcd") Send(Character(character));
+        Key("Left"); Key("Left"); Key("Delete"); Send(Character('X'));
+        CheckTerminalState("abXd", 3);
+        Check(true, "Physical Delete and uppercase insertion preserve terminal suffix and caret");
+        CloseWin10StockLesson();
+    }
